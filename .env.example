DISCORD_TOKEN=your_token_here
# 每次向網站發送請求的間隔秒數 (預設 60)。數字越大越不容易被限流 (HTTP 429)。
REQUEST_INTERVAL=60
# 選填：輪替使用的 proxy 清單 (逗號分隔)，每次請求會輪流換不同的出口 IP，
# 被限流或 proxy 掛掉時自動切下一個。留空則走直連。
# 例：PROXIES=http://user:pass@host1:port,http://host2:port,socks5://host3:port
PROXIES=
# 選填：每輪最多嘗試幾個 proxy 就放棄 (預設 5)。proxy 很多且多為免費/不穩時，
# 這能避免一次把幾十個死掉的 proxy 全試一遍而卡住。
PROXY_MAX_ATTEMPTS=5
# 選填：使用 proxy 時的單次請求逾時秒數 (預設 8)。免費 proxy 常是死的，縮短可快速跳過。
PROXY_TIMEOUT=8
